# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase.
# Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_…). ¡Nunca la Secret key!
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Sin estas variables, la app funciona en modo local (sin cuentas).
